// ApiMaster.js â€" Fixed routing for proper backend communication
import { useState } from "react";

/* -------------------------------------------------------
   0) MODE: read from CRA env; default EDGE if unset
------------------------------------------------------- */
const RAW_MODE = process.env.REACT_APP_MODE || 'EDGE';

const normalizeMode = (m) => {
  const up = String(m || '').toUpperCase();
  if (up === 'LOCAL') {
    if (typeof window !== 'undefined' && !window.__MODE_MIGRATION_WARNED__) {
      console.warn('[MODE] Detected legacy "LOCAL" â€" treating as "DEV". Please migrate to DEV/EDGE/CLOUD.');
      window.__MODE_MIGRATION_WARNED__ = true;
    }
    return 'DEV';
  }
  if (['DEV', 'EDGE', 'CLOUD'].includes(up)) return up;
  throw new Error(`[MODE] Unknown mode "${m}". Valid: DEV | EDGE | CLOUD`);
};

export const MODE = normalizeMode(RAW_MODE);

/* -------------------------------------------------------
   1) Origins & env override
------------------------------------------------------- */
const ORIGIN = (typeof window !== 'undefined' && window.location)
  ? window.location.origin
  : null;

const HOST = (typeof window !== 'undefined' && window.location)
  ? window.location.hostname
  : null;

// Explicit edge hostnames
const EDGE_HOSTS = new Set(['kindred.edge']);

// Optional explicit override
const ENV_API = process.env.REACT_APP_API_URL || null;

/* -------------------------------------------------------
   2) API_BASE resolution - FIXED for localhost detection
------------------------------------------------------- */
export const API_BASE =
  ENV_API ? ENV_API
  : (MODE === 'DEV' || (HOST && HOST.includes('localhost')))    ? 'http://localhost:8000'  // Force localhost:8000 for dev
  : (MODE === 'EDGE' || (HOST && EDGE_HOSTS.has(HOST)))
      ? `${ORIGIN || 'https://kindred.edge'}`
  : (MODE === 'CLOUD')  ? 'https://eduos-worker.shepherdn.workers.dev'
  : 'http://localhost:8000';  // Default fallback to localhost:8000

/* -------------------------------------------------------
   3) Mutable API base (runtime override support)
------------------------------------------------------- */
let apiUrl = API_BASE;

export const setApiUrl = (newUrl) => {
  apiUrl = newUrl;
};

export const getApiUrl = () => apiUrl;

export const useApiUrl = () => {
  const [currentApiUrl, setCurrentApiUrl] = useState(apiUrl);
  const updateApiUrl = (newUrl) => {
    setApiUrl(newUrl);
    setCurrentApiUrl(newUrl);
  };
  return [currentApiUrl, updateApiUrl];
};

/* -------------------------------------------------------
   4) Diagnostics
------------------------------------------------------- */
if (typeof window !== 'undefined' && !window.__API_BASE_LOGGED__) {
  console.log('[API] MODE:', MODE);
  console.log('[API] API_BASE:', API_BASE);
  window.__API_BASE_LOGGED__ = true;
}

/* -------------------------------------------------------
   5) Route helpers - FIXED to use /api/edu structure
------------------------------------------------------- */
export const EDU_SCIENCE     = `${API_BASE}/api/edu/science`;
export const EDU_TECHNOLOGY  = `${API_BASE}/api/edu/technology`;
export const EDU_ENGINEERING = `${API_BASE}/api/edu/engineering`;
export const EDU_ARTS        = `${API_BASE}/api/edu/arts`;
export const EDU_MATH        = `${API_BASE}/api/edu/math`;
export const EDU_LIFESTYLE   = `${API_BASE}/api/edu/lifestyle`;
export const OPENAI_ROUTE    = `${API_BASE}/api/openai`;  // Keep /api for non-edu routes
export const MODEL_ROUTE     = `${API_BASE}/api/model`;   // For your model endpoints

/* -------------------------------------------------------
   6) Subject & user/admin API re-exports
------------------------------------------------------- */
export * as ScienceAPI     from './Science.js';
export * as TechnologyAPI  from './Technology.js';
export * as EngineeringAPI from './Engineering.js';
export * as ArtsAPI        from './Arts.js';
export * as MathAPI        from './Math.js';
export * as LifestyleAPI   from './Lifestyle.js';
export * from './User.js';
export * from './Admin.js';

/* -------------------------------------------------------
   7) Dispatcher layer - FIXED routing
------------------------------------------------------- */
const subjectMap = {
  science: () => import('./Science.js'),
  math: () => import('./Math.js'),
  technology: () => import('./Technology.js'),
  engineering: () => import('./Engineering.js'),
  arts: () => import('./Arts.js'),
  lifestyle: () => import('./Lifestyle.js')
};

const capitalize = str => str.charAt(0).toUpperCase() + str.slice(1);

export async function fetchChatThread(subject, email, threadId) {
  const mod = await subjectMap[subject]?.();
  return mod?.[`fetch${capitalize(subject)}ChatThread`](email, threadId);
}

export async function fetchChatThreads(subject, email) {
  const mod = await subjectMap[subject]?.();
  return mod?.[`fetch${capitalize(subject)}ChatThreads`](email);
}

export async function saveChatThread(subject, payload) {
  const mod = await subjectMap[subject]?.();
  return mod?.[`save${capitalize(subject)}ChatThread`](payload);
}

export async function fetchStudentMarkdown(subject, email, filepath) {
  const mod = await subjectMap[subject]?.();
  return mod?.[`fetch${capitalize(subject)}StudentMarkdown`](email, filepath);
}

export async function saveStudentMarkdown(subject, email, filepath, content) {
  const mod = await subjectMap[subject]?.();
  return mod?.[`save${capitalize(subject)}StudentMarkdown`](email, filepath, content);
}

export async function logStudyStreak(subject, userId, streakCount) {
  const mod = await subjectMap[subject]?.();
  return mod?.[`log${capitalize(subject)}StudyStreak`](userId, streakCount);
}

export async function submitQuizResult(subject, data) {
  const mod = await subjectMap[subject]?.();
  return mod?.[`submit${capitalize(subject)}QuizResult`](data);
}

export async function logQuizAnalytics(subject, payload) {
  const mod = await subjectMap[subject]?.();
  return mod?.[`log${capitalize(subject)}QuizAnalytics`](payload);
}

export async function fetchTopics(subject) {
  const mod = await subjectMap[subject]?.();
  return mod?.[`fetch${capitalize(subject)}Topics`]();
}

export async function fetchUserProgress(subject, email) {
  const mod = await subjectMap[subject]?.();
  return mod?.[`fetchUser${capitalize(subject)}Progress`](email);
}

export async function queryModel(subject, prompt, modelKey = 'hermes', max_new_tokens = 750) {
  const mod = await subjectMap[subject]?.();
  return mod?.[`query${capitalize(subject)}Model`](prompt, modelKey, max_new_tokens);
}

/* -------------------------------------------------------
   8) UPDATED: Direct API helpers for common operations
------------------------------------------------------- */

// Helper for education endpoints - NOW USES /api/edu
export const makeEduRequest = async (endpoint, options = {}) => {
  const url = `${API_BASE}/api/edu${endpoint.startsWith('/') ? endpoint : '/' + endpoint}`;
  return fetch(url, {
    headers: {
      'Content-Type': 'application/json',
      ...options.headers
    },
    ...options
  });
};

// Helper for general API endpoints  
export const makeApiRequest = async (endpoint, options = {}) => {
  const url = `${API_BASE}/api${endpoint.startsWith('/') ? endpoint : '/' + endpoint}`;
  return fetch(url, {
    headers: {
      'Content-Type': 'application/json',
      ...options.headers
    },
    ...options
  });
};

// Helper for model queries
export const queryModelDirect = async (query, modelKey = 'hermes', maxTokens = 750) => {
  return makeApiRequest('/model/query', {
    method: 'POST',
    body: JSON.stringify({
      query,
      model_key: modelKey,
      max_new_tokens: maxTokens
    })
  });
};