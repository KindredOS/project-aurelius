import React, { useState, useEffect } from 'react';
import { fetchSchoolMetrics, fetchAllEngagement } from '../../api/Admin';
import styles from './AdminModules.module.css';

function SchoolPerformanceOverview({ dashboardData }) {
  const [metrics, setMetrics] = useState(null);
  const [loading, setLoading] = useState(false);
  const [showDetailedMetrics, setShowDetailedMetrics] = useState(false);

  const [showEngagementDetail, setShowEngagementDetail] = useState(false);
  const [engagementData, setEngagementData] = useState({});
  const [loadingEngagement, setLoadingEngagement] = useState(false);

  useEffect(() => {
    loadMetrics();
  }, []);

  const loadMetrics = async () => {
    try {
      setLoading(true);
      const metricsData = await fetchSchoolMetrics();
      setMetrics(metricsData);
    } catch (error) {
      console.error('Failed to load metrics:', error);
    } finally {
      setLoading(false);
    }
  };

  const toggleEngagementDetail = async () => {
    if (!showEngagementDetail) {
      try {
        setLoadingEngagement(true);
        const data = await fetchAllEngagement();
        setEngagementData(data);
      } catch (err) {
        console.error("Failed to fetch engagement detail", err);
      } finally {
        setLoadingEngagement(false);
      }
    }
    setShowEngagementDetail(!showEngagementDetail);
  };

  const formatBytes = (bytes) => {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  };

  const formatPercentage = (value) => {
    return `${Math.round(value * 100) / 100}%`;
  };

  // 🔧 Helper: minutes per point
  const calcMinutesPerPoint = (avgScore, totalMinutes) => {
    if (!avgScore || avgScore === 0) return 0;
    if (!totalMinutes || totalMinutes === 0) return 0;
    return (totalMinutes / avgScore).toFixed(1);
  };

  // 🔧 Helper: success vs program avg
  const calcSuccessMarker = (avgScore, allSubjects) => {
    const scores = Object.values(allSubjects).map(s => s.average_score || 0);
    if (!scores.length) return "N/A";
    const programAvg = scores.reduce((a, b) => a + b, 0) / scores.length;
    if (avgScore > programAvg) return "Above Avg";
    if (avgScore < programAvg) return "Below Avg";
    return "Avg";
  };

  return (
    <div className={styles.panel}>
      <div className={styles.panelHeader}>
        <h2>📊 School Performance Overview</h2>
        <button 
          className={styles.toggleButton}
          onClick={() => setShowDetailedMetrics(!showDetailedMetrics)}
        >
          {showDetailedMetrics ? 'Simple View' : 'Detailed View'}
        </button>
      </div>

      {loading ? (
        <div className={styles.loading}>Loading metrics...</div>
      ) : (
        <div className={styles.metricsContainer}>
          {!showDetailedMetrics ? (
            // Simple overview
            <div className={styles.simpleMetrics}>
              <div className={styles.metricCard}>
                <h4>User Activity</h4>
                <p>Active (7d): {metrics?.user_metrics?.active_last_7d || 0}</p>
                <p>Active (30d): {metrics?.user_metrics?.active_last_30d || 0}</p>
                <div className={styles.progressBar}>
                  <div 
                    className={styles.progressFill}
                    style={{ 
                      width: `${metrics?.user_metrics?.retention_rate_30d || 0}%` 
                    }}
                  ></div>
                </div>
                <small>
                  30-day retention: {formatPercentage(metrics?.user_metrics?.retention_rate_30d || 0)}
                </small>

                <p>Total Engagement Minutes: {metrics?.student_metrics?.total_engagement_minutes || 0}</p>
                <p>Avg Current Streak: {Math.round(metrics?.student_metrics?.average_current_streak || 0)}</p>
                <p>Avg Longest Streak: {Math.round(metrics?.student_metrics?.average_longest_streak || 0)}</p>

                {/* Engagement toggle */}
                <div className={styles.engagementSection}>
                  <button 
                    className={styles.detailToggleBtn} 
                    onClick={toggleEngagementDetail}
                    disabled={loadingEngagement}
                  >
                    {showEngagementDetail ? "Hide Engagement" : "Show Engagement"}
                  </button>

                  {showEngagementDetail && (
                    <div className={styles.engagementDropdown}>
                      {loadingEngagement ? (
                        <p>Loading engagement...</p>
                      ) : (
                        <table>
                          <thead>
                            <tr>
                              <th>Email</th>
                              <th>Minutes</th>
                              <th>Current Streak</th>
                              <th>Longest Streak</th>
                              <th>Last Active</th>
                            </tr>
                          </thead>
                          <tbody>
                            {Object.entries(engagementData).map(([email, e]) => (
                              <tr key={email}>
                                <td>{email}</td>
                                <td>{e.active_minutes}</td>
                                <td>{e.current_streak_days}</td>
                                <td>{e.longest_streak_days}</td>
                                <td>{e.last_active}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      )}
                    </div>
                  )}
                </div>
              </div>

              <div className={styles.metricCard}>
                <h4>Student Performance</h4>
                {metrics?.student_metrics?.subject_scores && 
                  Object.entries(metrics.student_metrics.subject_scores).map(([subj, data]) => (
                  <p key={subj}>
                    {subj.charAt(0).toUpperCase() + subj.slice(1)} Avg: {Math.round(data.average_score || 0)}
                    {" "} | Minutes/Point: {calcMinutesPerPoint(data.average_score, metrics?.student_metrics?.total_engagement_minutes)}
                    {" "} | {calcSuccessMarker(data.average_score, metrics?.student_metrics?.subject_scores)}
                  </p>
                ))}
              </div>
            </div>
          ) : (
            // Detailed metrics
            <div className={styles.detailedMetrics}>
              <div className={styles.metricSection}>
                <h3>User Metrics</h3>
                <div className={styles.metricItem}>
                  <label>Total Users:</label>
                  <span>{metrics?.user_metrics?.total_users || 0}</span>
                </div>
                <div className={styles.metricItem}>
                  <label>Active (7d):</label>
                  <span>{metrics?.user_metrics?.active_last_7d || 0}</span>
                </div>
                <div className={styles.metricItem}>
                  <label>Active (30d):</label>
                  <span>{metrics?.user_metrics?.active_last_30d || 0}</span>
                </div>
                <div className={styles.metricItem}>
                  <label>Retention 30d:</label>
                  <span>{formatPercentage(metrics?.user_metrics?.retention_rate_30d || 0)}</span>
                </div>
                <div className={styles.metricItem}>
                  <label>Total Engagement Minutes:</label>
                  <span>{metrics?.student_metrics?.total_engagement_minutes || 0}</span>
                </div>
                <div className={styles.metricItem}>
                  <label>Avg Current Streak:</label>
                  <span>{Math.round(metrics?.student_metrics?.average_current_streak || 0)}</span>
                </div>
                <div className={styles.metricItem}>
                  <label>Avg Longest Streak:</label>
                  <span>{Math.round(metrics?.student_metrics?.average_longest_streak || 0)}</span>
                </div>
              </div>

              <div className={styles.metricSection}>
                <h3>Student Metrics</h3>
                {metrics?.student_metrics?.subject_scores && 
                  Object.entries(metrics.student_metrics.subject_scores).map(([subj, data]) => (
                  <div className={styles.metricItem} key={subj}>
                    <label>{subj.charAt(0).toUpperCase() + subj.slice(1)} Avg:</label>
                    <span>
                      {Math.round(data.average_score || 0)} | 
                      Minutes/Point: {calcMinutesPerPoint(data.average_score, metrics?.student_metrics?.total_engagement_minutes)} | 
                      {calcSuccessMarker(data.average_score, metrics?.student_metrics?.subject_scores)}
                    </span>
                  </div>
                ))}
              </div>

              <div className={styles.metricSection}>
                <h3>System Health</h3>
                <div className={styles.metricItem}>
                  <label>Data Directory Size:</label>
                  <span>{formatBytes(metrics?.system_health?.data_directory_size || 0)}</span>
                </div>
                <div className={styles.metricItem}>
                  <label>Total Files:</label>
                  <span>{metrics?.system_health?.total_files || 0}</span>
                </div>
              </div>
            </div>
          )}
        </div>
      )}

      <div className={styles.actionButtons}>
        <button 
          className={styles.refreshBtn}
          onClick={loadMetrics}
          disabled={loading}
        >
          🔄 Refresh Metrics
        </button>
      </div>
    </div>
  );
}

export default SchoolPerformanceOverview;
